#!/usr/bin/env python3
# Copyright (C) 2026 Hugo (hg-prst) - License: MIT
"""check_file_hash - Nagios/Checkmk active check.

Downloads a file over HTTP(S), computes its hash and compares it with the
expected value.  Python 3 standard library only.

Exit codes: 0 OK (hash matches), 2 CRIT (mismatch or download error),
            3 UNKNOWN (invalid arguments / internal error).
"""

import argparse
import hashlib
import socket
import ssl
import sys
import time
import urllib.error
import urllib.request

OK, WARN, CRIT, UNKNOWN = 0, 1, 2, 3
STATE_NAMES = {OK: "OK", WARN: "WARN", CRIT: "CRIT", UNKNOWN: "UNKNOWN"}
ALGORITHMS = {"md5": 32, "sha1": 40, "sha256": 64, "sha512": 128}  # expected hex length
CHUNK_SIZE = 1024 * 1024
USER_AGENT = "checkmk-check_file_hash/1.0.0"


class ArgumentError(Exception):
    pass


class _Parser(argparse.ArgumentParser):
    def error(self, message: str) -> None:  # argparse would exit with 2 (= CRIT)
        raise ArgumentError(message)


def parse_arguments(argv: list[str]) -> argparse.Namespace:
    parser = _Parser(description="Download a file and verify its hash.")
    parser.add_argument("--url", required=True, help="HTTP(S) URL of the file")
    parser.add_argument(
        "--algorithm", default="sha256", choices=sorted(ALGORITHMS), help="hash algorithm"
    )
    parser.add_argument("--expected", required=True, help="expected hash (hex)")
    parser.add_argument("--timeout", type=float, default=30.0, help="timeout in seconds")
    parser.add_argument(
        "--no-verify-tls", action="store_true", help="do not verify the TLS certificate"
    )
    args = parser.parse_args(argv)

    if not args.url.lower().startswith(("http://", "https://")):
        raise ArgumentError("--url must start with http:// or https://")
    args.expected = "".join(args.expected.split()).lower()
    want_len = ALGORITHMS[args.algorithm]
    if len(args.expected) != want_len or any(c not in "0123456789abcdef" for c in args.expected):
        raise ArgumentError(
            f"--expected is not a valid {args.algorithm} hash "
            f"({want_len} hexadecimal characters expected)"
        )
    if args.timeout <= 0:
        raise ArgumentError("--timeout must be > 0")
    return args


def download_and_hash(url: str, algorithm: str, timeout: float, verify_tls: bool) -> tuple[str, int]:
    context = ssl.create_default_context()
    if not verify_tls:
        context.check_hostname = False
        context.verify_mode = ssl.CERT_NONE
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    digest = hashlib.new(algorithm)
    size = 0
    with urllib.request.urlopen(request, timeout=timeout, context=context) as response:
        while chunk := response.read(CHUNK_SIZE):
            digest.update(chunk)
            size += len(chunk)
    return digest.hexdigest(), size


def perfdata(size: int | None, duration: float) -> str:
    parts = []
    if size is not None:
        parts.append(f"size={size}B;;;0")
    parts.append(f"duration={duration:.3f}s;;;0")
    return " ".join(parts)


def run(argv: list[str]) -> tuple[int, str]:
    try:
        args = parse_arguments(argv)
    except ArgumentError as exc:
        return UNKNOWN, f"Invalid arguments: {exc}"

    start = time.monotonic()
    try:
        got, size = download_and_hash(
            args.url, args.algorithm, args.timeout, not args.no_verify_tls
        )
    except urllib.error.HTTPError as exc:
        return CRIT, (
            f"Download failed: HTTP {exc.code} {exc.reason} ({args.url})"
            f" | {perfdata(None, time.monotonic() - start)}"
        )
    except urllib.error.URLError as exc:
        return CRIT, (
            f"Download failed: {exc.reason} ({args.url})"
            f" | {perfdata(None, time.monotonic() - start)}"
        )
    except (socket.timeout, TimeoutError):
        return CRIT, (
            f"Download failed: timeout after {args.timeout:g}s ({args.url})"
            f" | {perfdata(None, time.monotonic() - start)}"
        )
    except (OSError, ValueError, ssl.SSLError) as exc:
        return CRIT, (
            f"Download failed: {exc} ({args.url})"
            f" | {perfdata(None, time.monotonic() - start)}"
        )
    duration = time.monotonic() - start

    algo = args.algorithm.upper()
    if got == args.expected:
        return OK, (
            f"{algo} hash matches ({got}), size {size} bytes, downloaded in {duration:.2f}s"
            f" | {perfdata(size, duration)}"
        )
    return CRIT, (
        f"{algo} hash MISMATCH: expected {args.expected}, got {got} (size {size} bytes)"
        f" | {perfdata(size, duration)}"
    )


def main() -> int:
    try:
        state, text = run(sys.argv[1:])
    except Exception as exc:  # pylint: disable=broad-except
        state, text = UNKNOWN, f"Internal error: {exc!r}"
    sys.stdout.write(f"{text}\n")
    return state


if __name__ == "__main__":
    sys.exit(main())
